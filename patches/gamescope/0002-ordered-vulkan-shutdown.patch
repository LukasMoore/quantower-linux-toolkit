+void CVulkanDevice::shutdownCommandBuffers()
+{
+	// Complete compilation and GPU submissions while the driver is still alive.
+	// Global C++ destruction runs after driver exit handlers on some NVIDIA stacks.
+	m_pipelineThread.request_stop();
+	if (m_pipelineThread.joinable())
+		m_pipelineThread.join();
+	if (!m_device)
+		return;
+	waitIdle();
+	m_pendingCmdBufs.clear();
+	m_unusedCmdBufs.clear();
+}
+
