+
+void vulkan_shutdown()
+{
+	// Release owning globals before the driver's process-exit handlers run.
+	g_device.shutdownCommandBuffers();
+	g_output = VulkanOutput_t{};
+	for (auto &luts : g_ColorMgmtLuts)
+		luts.shutdown();
+}
 
