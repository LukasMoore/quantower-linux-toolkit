+
+    X11DRV_expect_error( display, device_mapping_error_handler, (void *)(UINT_PTR)X_OpenDevice );
+    device = pXOpenDevice( display, deviceid );
+    error = X11DRV_check_error();
+    if (error || !device)
+    {
+        WARN( "Unable to open cursor device %d, using identity mapping.\n", deviceid );
+        if (device) close_mapping_device( display, device );
+    }
+    else
+    {
+        X11DRV_expect_error( display, device_mapping_error_handler, (void *)(UINT_PTR)X_GetDeviceButtonMapping );
+        count = pXGetDeviceButtonMapping( display, device, tmp->buttons, ARRAY_SIZE( tmp->buttons ) );
+        error = X11DRV_check_error();
+        if (error || count <= 0 || (unsigned int)count > ARRAY_SIZE( tmp->buttons ))
+        {
+            WARN( "Unable to map cursor device %d, using identity mapping.\n", deviceid );
+            init_device_mapping( tmp, deviceid );
+        }
+        else tmp->button_count = count;
+        close_mapping_device( display, device );
+    }
 
