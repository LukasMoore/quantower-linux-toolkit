+static int device_mapping_error_handler( Display *display, XErrorEvent *event, void *arg )
+{
+    unsigned int request = (UINT_PTR)arg;
+
+    return event->request_code == xinput2_opcode && event->minor_code == request &&
+           (event->error_code == xinput_error_base + XI_BadDevice ||
+            (request == X_GetDeviceButtonMapping && event->error_code == BadMatch));
+}
+
+static void close_mapping_device( Display *display, XDevice *device )
+{
+    X11DRV_expect_error( display, device_mapping_error_handler, (void *)(UINT_PTR)X_CloseDevice );
+    pXCloseDevice( display, device );
+    XSync( display, False );
+    if (X11DRV_check_error()) WARN( "Cursor device disappeared while closing.\n" );
+}
+
+static void init_device_mapping( struct mouse_button_mapping *mapping, int deviceid )
+{
+    unsigned int i;
+
+    mapping->deviceid = deviceid;
+    mapping->button_count = ARRAY_SIZE( mapping->buttons );
+    for (i = 0; i < mapping->button_count; i++) mapping->buttons[i] = i + 1;
+}
+
