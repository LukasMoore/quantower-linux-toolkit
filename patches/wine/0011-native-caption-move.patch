+/* Private direct-host opt-in: let ordinary caption moves bypass application
+ * grouping interception without changing any other non-client message. */
+static const WCHAR qtk_caption_move_option[] = L"QTK_NATIVE_CAPTION_MOVE";
+static const WCHAR qtk_caption_trace_option[] = L"QTK_NATIVE_CAPTION_TRACE";
+static const WCHAR qtk_native_placement_prop[] = L"__wine_qtk_native_placement";
+static const WCHAR qtk_caption_move_prop[] = L"__wine_qtk_native_caption_move";
+static const WCHAR qtk_whole_window_prop[] = L"__wine_x11_whole_window";
+static LONG qtk_caption_trace_count;
+static LONG qtk_caption_trace_started;
+static DWORD qtk_caption_trace_start_tick;
+static _Thread_local LONG qtk_caption_trace_parent;
+static _Thread_local UINT qtk_caption_trace_depth;
