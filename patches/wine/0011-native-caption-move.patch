+static BOOL qtk_option_one( const WCHAR *name )
+{
+    WCHAR value[2];
+    return GetEnvironmentVariableW( name, value, ARRAY_SIZE(value) ) == 1 && value[0] == '1';
+}
+
+/* Internal text/class queries read server metadata, never WM_GETTEXT callbacks. */
+static BOOL qtk_caption_scope( HWND hwnd )
+{
+    static const WCHAR class_prefix[] = L"HwndWrapper[Starter;;";
+    WCHAR class_name[128], title[64];
+    DWORD pid, owner_pid, tid, owner_tid;
+    HWND owner;
+    LONG style, ex_style;
+    INT prefix_len = ARRAY_SIZE(class_prefix) - 1;
+
+    tid = GetWindowThreadProcessId( hwnd, &pid );
+    if (tid != GetCurrentThreadId() || pid != GetCurrentProcessId()) return FALSE;
+    if (NtUserGetAncestor( hwnd, GA_ROOT ) != hwnd) return FALSE;
+    style = GetWindowLongW( hwnd, GWL_STYLE );
+    ex_style = GetWindowLongW( hwnd, GWL_EXSTYLE );
+    if (!(style & WS_THICKFRAME) || (style & (WS_CHILD | WS_POPUP))) return FALSE;
+    if (!(ex_style & WS_EX_APPWINDOW) || (ex_style & (WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE | WS_EX_DLGMODALFRAME))) return FALSE;
+    if (GetClassNameW( hwnd, class_name, ARRAY_SIZE(class_name) ) < prefix_len ||
+        memcmp( class_name, class_prefix, prefix_len * sizeof(WCHAR) )) return FALSE;
+    if (!NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) ) ||
+        (wcscmp( title, L"Chart" ) && wcscmp( title, L"Group" ))) return FALSE;
+    if (!(owner = GetWindow( hwnd, GW_OWNER ))) return FALSE;
+    owner_tid = GetWindowThreadProcessId( owner, &owner_pid );
+    if (owner_tid != tid || owner_pid != pid || GetWindow( owner, GW_OWNER ) ||
+        NtUserGetAncestor( owner, GA_ROOT ) != owner) return FALSE;
+    if (!(GetWindowLongW( owner, GWL_STYLE ) & WS_VISIBLE) || !IsWindowEnabled( owner )) return FALSE;
+    if (GetClassNameW( owner, class_name, ARRAY_SIZE(class_name) ) < prefix_len ||
+        memcmp( class_name, class_prefix, prefix_len * sizeof(WCHAR) )) return FALSE;
+    return NtUserInternalGetWindowText( owner, title, ARRAY_SIZE(title) ) && !wcscmp( title, L"AMP Quantower" );
+}
+
+enum qtk_caption_action { QTK_CAPTION_PASS, QTK_CAPTION_NATIVE, QTK_CAPTION_BLOCK_UNSUPPORTED };
+
+static enum qtk_caption_action qtk_caption_action( const struct win_proc_params *params )
+{
+    DWORD error = NtCurrentTeb()->LastErrorValue;
+    enum qtk_caption_action action = QTK_CAPTION_PASS;
+    HANDLE whole;
+    LONG style;
+
+    if (params->msg != WM_NCLBUTTONDOWN || params->wparam != HTCAPTION) return action;
+    if (params->procA == WINPROC_PROC16 || params->procW == WINPROC_PROC16) return action;
+    if (!qtk_option_one( qtk_caption_move_option ) || !qtk_caption_scope( params->hwnd )) goto done;
+    style = GetWindowLongW( params->hwnd, GWL_STYLE );
+    if (!(style & WS_VISIBLE) || (style & (WS_DISABLED | WS_MINIMIZE))) goto done;
+    whole = GetPropW( params->hwnd, qtk_whole_window_prop );
+    if (!whole || GetPropW( params->hwnd, qtk_native_placement_prop ) != whole) goto done;
+    action = GetPropW( params->hwnd, qtk_caption_move_prop ) == whole ?
+             QTK_CAPTION_NATIVE : QTK_CAPTION_BLOCK_UNSUPPORTED;
+done:
+    NtCurrentTeb()->LastErrorValue = error;
+    return action;
+}
+
+static BOOL qtk_caption_trace_message( UINT msg, WPARAM wp )
+{
+    switch (msg)
+    {
+    case WM_NCLBUTTONDOWN:
+    case WM_NCLBUTTONUP:
+    case WM_NCLBUTTONDBLCLK:
+    case WM_ENTERSIZEMOVE:
+    case WM_EXITSIZEMOVE:
+    case WM_CANCELMODE:
+    case WM_CAPTURECHANGED:
+        return TRUE;
+    case WM_SYSCOMMAND:
+        return (wp & 0xfff0) == SC_MOVE || (wp & 0xfff0) == SC_SIZE;
+    default:
+        return FALSE;
+    }
+}
+
+static LONG qtk_caption_trace_begin( HWND hwnd, UINT msg, WPARAM wp, LPARAM lp, UINT reason,
+                                     LONG *parent, UINT *depth )
+{
+    DWORD error = NtCurrentTeb()->LastErrorValue;
+    LONG call = 0;
+
+    if (!qtk_caption_trace_message( msg, wp ) || !qtk_option_one( qtk_caption_trace_option ) ||
+        !qtk_caption_scope( hwnd )) goto done;
+    if (!InterlockedCompareExchange( &qtk_caption_trace_started, 1, 0 ))
+    {
+        qtk_caption_trace_start_tick = GetTickCount();
+        InterlockedExchange( &qtk_caption_trace_started, 2 );
+    }
+    if (InterlockedCompareExchange( &qtk_caption_trace_started, 2, 2 ) != 2 ||
+        (DWORD)(GetTickCount() - qtk_caption_trace_start_tick) >= 600000) goto done;
+    call = InterlockedIncrement( &qtk_caption_trace_count );
+    if (call > 1024)
+    {
+        if (call == 1025)
+            WARN_(qtkcaption)( "QTKCAP phase=2 call=%ld tid=%lu tick=%lu limit=1024 reason=3\n",
+                              call, GetCurrentThreadId(), GetTickCount() );
+        call = 0;
+        goto done;
+    }
+    *parent = qtk_caption_trace_parent;
+    *depth = qtk_caption_trace_depth;
+    qtk_caption_trace_parent = call;
+    qtk_caption_trace_depth++;
+    WARN_(qtkcaption)( "QTKCAP phase=0 call=%ld parent=%ld depth=%u tid=%lu tick=%lu hwnd=%p msg=%u hit=%d command=%u capture=%p reason=%u\n",
+        call, *parent, *depth, GetCurrentThreadId(), GetTickCount(), hwnd, msg,
+        msg >= WM_NCLBUTTONDOWN && msg <= WM_NCLBUTTONDBLCLK &&
+        (INT_PTR)wp >= HTERROR && (INT_PTR)wp <= HTHELP ? (int)(INT_PTR)wp : 0,
+        msg == WM_SYSCOMMAND ? (UINT)(wp & 0xfff0) : 0,
+        msg == WM_CAPTURECHANGED ? (HWND)lp : 0, reason );
+done:
+    NtCurrentTeb()->LastErrorValue = error;
+    return call;
+}
+
+static void qtk_caption_trace_end( LONG call, LONG parent, UINT depth, HWND hwnd, UINT msg,
+                                   LRESULT result, UINT reason )
+{
+    DWORD error = NtCurrentTeb()->LastErrorValue;
+    int hit = msg == WM_NCHITTEST && result >= HTERROR && result <= HTHELP ? result : 0;
+
+    if (!call) return;
+    WARN_(qtkcaption)( "QTKCAP phase=1 call=%ld parent=%ld depth=%u tid=%lu tick=%lu hwnd=%p msg=%u hit=%d result_zero=%u reason=%u\n",
+        call, parent, depth, GetCurrentThreadId(), GetTickCount(), hwnd, msg, hit, !result, reason );
+    qtk_caption_trace_parent = parent;
+    qtk_caption_trace_depth = depth;
+    NtCurrentTeb()->LastErrorValue = error;
+}
