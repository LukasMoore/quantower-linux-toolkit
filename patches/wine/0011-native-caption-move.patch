+/* These server properties carry the current XID, not a truthy stale flag.
+ * The PE policy additionally checks the application role before bypassing it. */
+static BOOL use_native_caption_move( const struct x11drv_win_data *data )
+{
+    const char *value = getenv( "QTK_NATIVE_CAPTION_MOVE" );
+
+    return value && !strcmp( value, "1" ) && use_native_window_placement( data );
+}
+
+static void set_native_caption_prop( HWND hwnd, const WCHAR *name, HANDLE value )
+{
+    if (NtUserGetProp( hwnd, name ) == value) return;
+    if (value) NtUserSetProp( hwnd, name, value );
+    else NtUserRemoveProp( hwnd, name );
+}
+
+static void sync_native_caption_props( struct x11drv_win_data *data )
+{
+    HANDLE whole = use_native_caption_move( data ) ? (HANDLE)data->whole_window : 0;
+    HANDLE movable = whole && is_net_supported( x11drv_atom(_NET_WM_MOVERESIZE) ) ? whole : 0;
+
+    set_native_caption_prop( data->hwnd, qtk_native_placement_prop, whole );
+    set_native_caption_prop( data->hwnd, qtk_caption_move_prop, movable );
+}
