+/* In this opt-in direct-host mode the native WM owns fullscreen placement.
+ * Keep Wine's coordinate/style translation, including data->is_fullscreen for
+ * resizability, but do not infer a host fullscreen request from window bounds. */
+static BOOL use_native_window_placement( const struct x11drv_win_data *data )
+{
+    const char *value = getenv( "QTK_NATIVE_WINDOW_PLACEMENT" );
+
+    return value && !strcmp( value, "1" ) && data->managed && !data->embedded &&
+           data->whole_window && data->whole_window != root_window && !is_virtual_desktop();
+}
+
 static void window_set_net_wm_fullscreen_monitors( struct x11drv_win_data *data, const struct monitor_indices *new_monitors )
 {
     const struct monitor_indices *old_monitors = &data->pending_state.monitors;
+
+    if (use_native_window_placement( data )) return; /* monitor choice belongs to the native WM */
     data->desired_state.monitors = *new_monitors;
 
     if (!(data->pending_state.net_wm_state & (1 << NET_WM_STATE_FULLSCREEN)) || is_virtual_desktop()) return; /* window isn't fullscreen, delay updating */
