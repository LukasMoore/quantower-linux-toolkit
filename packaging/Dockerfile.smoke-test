# Isolated reference desktop fixture. It deliberately has no Wine/compiler SDKs.
FROM debian:13-slim@sha256:7378260c0a098d27ac206225db5e7d92b8c7c84ea7afccc86eeb513756bbd392
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 bash ca-certificates xvfb xauth x11-utils xdotool \
    libgl1 libegl1 libgles2 libglx-mesa0 libgbm1 libdrm2 \
    libvulkan1 mesa-vulkan-drivers fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/test-home
RUN mkdir /test-home && chown 1000:1000 /test-home
USER 1000:1000
WORKDIR /test-home
